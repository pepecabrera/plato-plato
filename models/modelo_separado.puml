title Plato-Plató | Modelo conceptual: estructura completa
package "Acceso" #EDF2FF {
class Usuario <<entidad>> {
  nombre
  correoElectronico
  contraseñaProtegida
  estado : EstadoRegistro
  fechaCreacion
}
class Rol <<entidad>> {
  nombre : TipoRol
}
class Permiso <<entidad>> {
  nombre
}
}
package "Compras" #ECFDF5 {
class Proveedor <<entidad>> {
  nombre
  informacionContacto
  formaPago
  estado : EstadoRegistro
}
class Ingrediente <<entidad>> {
  nombre
  categoria
  unidadMedida
  estado : EstadoRegistro
  /cantidadTotalDisponible
}
class PrecioCompra <<entidad>> {
  precioCompra
  unidadPrecio
  fechaInicioVigencia
  fechaFinVigencia [0..1]
  seleccionadoParaCosteo
}
}
package "Elaboraciones" #FFF7ED {
class Plato <<entidad>> {
  nombre
  imagen
  descripcion
  categoria
  menuDelDia
  precioVenta
  estado : EstadoRegistro
  porcentajeMargenObjetivo [0..1]
  /costeProduccion [0..1]
  /margenBruto [0..1]
  /porcentajeMargen [0..1]
}
class Subreceta <<entidad>> {
  nombre
  cantidadRendimiento
  unidadRendimiento
  /costeUnitario [0..1]
}
class Receta <<entidad>> {
  estado : EstadoRegistro
  /costeElaboracion [0..1]
}
class ComponenteReceta <<entidad>> {
  cantidad
  unidadMedida
}
}
package "Almacén y pérdidas" #F0F9FF {
class Lote <<entidad>> {
  identificadorLote
  /cantidad
  fechaEntrada
  fechaCaducidad [0..1]
  ubicacionAlmacen
  fresco
  aptoParaConsumo
}
class MovimientoStock <<entidad>> {
  tipo : TipoMovimiento
  cantidad
  fechaMovimiento
  finalidadSalida : FinalidadSalida [0..1]
}
class Merma <<entidad>> {
  cantidadDesperdiciada
  fechaMerma
  motivo
  costePerdida
}
}
package "Oferta y autorización" #FAF5FF {
class PeriodoOferta <<entidad>> {
  tipo : TipoOferta
  fechaInicio
  fechaFin [0..1]
}
class AutorizacionCarta <<entidad>> {
  fechaAutorizacion
  costeEvaluado
  precioVentaEvaluado
}
}

Usuario "0..*" -left- "1" Rol : tieneRol
Rol "0..*" -down- "0..*" Permiso : concede
Usuario "0..*" -down- "0..*" Permiso : tienePermisoAdicional
Proveedor "1" -- "0..*" PrecioCompra : ofrece
Ingrediente "1" -- "0..*" PrecioCompra : tienePrecio
Ingrediente "1" -- "0..*" Lote : tieneLote
Lote "1" -- "0..*" MovimientoStock : recibeMovimiento
Plato "0..1" -- "1" Receta : tieneReceta
Subreceta "0..1" -- "1" Receta : tieneReceta
Receta "1" *-- "1..*" ComponenteReceta : seComponeDe
ComponenteReceta "0..*" -- "0..1" Ingrediente : utilizaIngrediente
ComponenteReceta "0..*" -- "0..1" Subreceta : utilizaSubreceta
Merma "0..*" -- "0..1" Lote : afectaLote
Merma "0..*" -- "0..1" Plato : afectaPlato
Merma "0..1" -left- "0..1" MovimientoStock : originaSalida
MovimientoStock "0..*" -- "0..1\nplatoDestino" Plato : seDestinaA
Plato "1" -- "0..*" PeriodoOferta : tienePeriodoOferta
PeriodoOferta "1" -- "0..1" AutorizacionCarta : tieneAutorizacion
Usuario "1" -- "0..*" AutorizacionCarta : emite


note bottom of Receta
  {Propietario exclusivo: cada Receta pertenece
  a exactamente un Plato o una Subreceta.}
end note
note bottom of ComponenteReceta
  {Componente exclusivo: utiliza exactamente
  un Ingrediente o una Subreceta.}
end note
note bottom of Merma
  {Elemento afectado exclusivo: exactamente
  un Lote o un Plato.}
end note

legend bottom
Cada extremo indica cuántos objetos de esa clase se relacionan con uno del otro extremo.
0..1 = opcional; 0..* = cero o más; 1..* = uno o más; 1 = exactamente uno.
Rombo negro: las líneas de receta pertenecen a una única receta.
/atributo = valor derivado; [0..1] = atributo opcional; tipos solo en enumerados.
La selección para costear se registra en seleccionadoParaCosteo de PrecioCompra.
Las vistas 02-06 desarrollan todas las restricciones y los cinco enumerados.
endlegend
@enduml

